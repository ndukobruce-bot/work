{
  "name": "workvault",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "tsc --noEmit",
    "typecheck": "tsc --noEmit",
    "db:push": "prisma db push",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "tsx scripts/db-deploy.ts",
    "test": "tsx --test tests/*.test.ts && tsx tests/login.integration.ts",
    "postinstall": "prisma generate",
    "account:password": "tsx prisma/set-account-password.ts"
  },
  "dependencies": {
    "@next/env": "^15.5.9",
    "@prisma/client": "^6.3.1",
    "lucide-react": "^0.468.0",
    "next": "^15.1.6",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "recharts": "^2.15.0",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@types/node": "^22.10.5",
    "@types/react": "^19.0.7",
    "@types/react-dom": "^19.0.3",
    "prisma": "^6.3.1",
    "tailwindcss": "^3.4.17",
    "postcss": "^8.4.49",
    "autoprefixer": "^10.4.20",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3"
  }
}
